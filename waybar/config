{
  "layer": "top",
  "postition": "top",

  "modules-left": [
    "dwl/window#layout",
    "ext/workspaces",
    "dwl/window#name"
  ],
  "modules-center": [ "tray" ],
  "modules-right": [
    "pulseaudio",
    "network",
    "memory",
    "cpu",
    "battery",
    "clock"
  ],

  "dwl/window#layout": {
    "format": "{layout}", 
  },
  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": true,
    "on-click": "activate",
    "on-click-right": "deactivate",
    "sort-by-id": true
  },
  "dwl/window#name": {
    "format": "{title}"
  },

  /*"custom/bitwig": {
    "format": "    ",
    "on-click": "kitty nohup bitwig-studio"
  },*/

  "battery": {
	"interval": 10,
	"states": {
		"warning": 30,
		"critical": 15
	},
	"format-time": "{H}:{M:02}",
	"format": "{icon} {capacity}%",
	"format-charging": " {capacity}%",
	"format-charging-full": " {capacity}%",
	"format-full": "{icon} {capacity}%",
	"format-alt": "{icon} {power}W",
	"format-icons": [
		" ",
		" ",
		" ",
		" ",
		" "
	],
	"tooltip": "{time}"
	},


 "clock": {
	"interval": 10,
	"format": "{:%H:%M}",
	"format-alt": "{:%e %b %Y}",
	"tooltip": true,
	"tooltip-format": "<tt><small>{calendar}</small></tt>",
	"calendar": {
		"mode"          : "year",
		"mode-mon-col"  : 3,
		"weeks-pos"     : "right",
		"on-scroll"     : 1,
		"on-click-right": "mode",
		"format": {
			"months":     "<span color='#ffead3'><b>{}</b></span>",
			"days":       "<span color='#ecc6d9'><b>{}</b></span>",
			"weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
			"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
			"today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
		}
	},
	},

 "cpu":{
   "interval": 5,
   "format": "  {usage}%",
   "states": {
	"warning": 70,
	"critical": 90
	},
   "tooltip": false
   },

   "pulseaudio": {
		"format": "{icon} {volume}%",
		"format-bluetooth": "{icon} {volume}%",
		"format-muted": " ",
		"format-icons": {
			"headphone": " ",
			"default": [" ", " "]
		},
		"scroll-step": 1,
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"tooltip": false
	},

 "memory":{
   "interval": 5,
   "format": "  {percentage}%",
	 "format-alt": "  {used:0.1f}/{total:0.1f}G",
   "states": {
     "warning": 70,
     "critical": 90
    },
   "tooltip": false
  },

 "network":{
   "format": "{icon} {signalStrength}%",
   "format-icons": 
    [
        "󰤯 ",
	"󰤟 ",
	"󰤢 ",
	"󰤥 ",
	"󰤨 "
    ],
   "on-click": "rofi-network-manager"
 },

};
